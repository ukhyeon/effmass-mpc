!/goal1/live/*/compare_tip/*.mp4
!/goal1/live/*/compare_tip/*.json
!/goal1/live/*/compare_tip/*.yml
# real_prep1-3: real-robot preparation reports only (REPORT.md, FORMAT.md); no npz, csv exports, logs, test data
!/goal1/real_prep1/
/goal1/real_prep1/*
!/goal1/real_prep1/REPORT.md
!/goal1/real_prep1/mpc_traj_export/
