# Allowlist: ignore everything, then re-include only what is published.
# Not published: SMPL models, human data (npz, Kinect recordings), third-party code (curobo, ref/, ws/),
# robot assets / USD, Isaac Sim, CUDA, caches, frame/rec folders, large videos.
/*
!/.gitignore
!/README.md
!/docs/
!/media/
# result analysis: README, figure and GIF/mp4 copies (human npz, mesh vertices, frames excluded below)
!/analysis/

!/goal1/
/goal1/*

# my code and config
!/goal1/scripts/
/goal1/scripts/*
!/goal1/scripts/*.py
!/goal1/scripts/*.sh
!/goal1/config/
!/goal1/scene_g1.json

# part_regen: per-part reference comparison (report, figures, summaries, composed video); no npz (zone mesh), no rec/ clips
!/goal1/part_regen/
/goal1/part_regen/*
!/goal1/part_regen/REPORT.md
!/goal1/part_regen/*.png
!/goal1/part_regen/*.json
!/goal1/part_regen/*.mp4
!/goal1/part_regen/runs.tsv

# reports
!/goal1/step1_2_report.md
!/goal1/step1_3_report.md

# summary logs (static stages only)
!/goal1/logs/
/goal1/logs/*
!/goal1/logs/meff_isaac/
/goal1/logs/meff_isaac/*
!/goal1/logs/meff_isaac/b2a4_*.json
!/goal1/logs/meff_isaac/b2a5_*.json
!/goal1/logs/meff_isaac/t1_*.json
!/goal1/logs/meff_isaac/v1_*.json
!/goal1/logs/meff_isaac/v2_*.json
!/goal1/logs/meff_isaac/g13_*.json
!/goal1/logs/meff_isaac/g1d_*.json
!/goal1/logs/meff_isaac/r1_motion_check.json
!/goal1/logs/meff_isaac/r1_runs.json
!/goal1/logs/meff_isaac/r1_passes.json
!/goal1/logs/meff_isaac/r1_summary.json
!/goal1/logs/meff_isaac/r1_*bitcheck.json
!/goal1/logs/meff_isaac/r1_video_info.json
!/goal1/logs/meff_isaac/on_wp*.json
!/goal1/logs/*.json

# MPC run node and environment-check scripts (my code)
!/env_check/
/env_check/*
!/env_check/scripts/
/env_check/scripts/*
!/env_check/scripts/*.py
!/env_check/scripts/*.sh

# figures and scene files
!/goal1/b2a/
/goal1/b2a/*
!/goal1/b2a/b2a5_fig*.png
!/goal1/b2a/g2/
/goal1/b2a/g2/*
!/goal1/b2a/g2/scene_*.json
!/goal1/zone/
/goal1/zone/*
!/goal1/zone/*.png
!/goal1/r1/
/goal1/r1/*
!/goal1/r1/*.png

# overnight run notes, figures, summary json (<= 5 MB)
!/goal1/overnight/
/goal1/overnight/*
!/goal1/overnight/*.md
!/goal1/overnight/*.png
!/goal1/overnight/*.json
!/goal1/overnight/*.tsv

# never, even if matched above
*.npz
*.npy
*.pkl
*.usd
*.usda
*.usdc
__pycache__/
*.pyc
human_r1_*
/goal1/b2a/demo/
/analysis/**/frames*/
/analysis/**/rec/
/analysis/**/*.obj
/analysis/**/*.ply
